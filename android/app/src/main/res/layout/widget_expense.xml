<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/expense_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_expense_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/expense_header"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:scaleType="fitStart" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/expense_cat_food"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/widget_circle_sole"
                android:contentDescription="Cibo"
                android:padding="14dp"
                android:src="@drawable/ic_widget_food" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Cibo"
                android:textColor="#11153A"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/expense_cat_activity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/widget_circle_corallo"
                android:contentDescription="Attività"
                android:padding="14dp"
                android:src="@drawable/ic_widget_activity" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Attività"
                android:textColor="#11153A"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/expense_cat_taxi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/widget_circle_cobalto"
                android:contentDescription="Taxi"
                android:padding="14dp"
                android:src="@drawable/ic_widget_taxi" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Taxi"
                android:textColor="#11153A"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/expense_cat_other"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/widget_circle_ink"
                android:contentDescription="Altro"
                android:padding="14dp"
                android:src="@drawable/ic_widget_plus" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Altro"
                android:textColor="#11153A"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
